# Schedule Links Backend Environment Configuration
PORT=3001

# Option 1: Bcrypt Hash of the Admin Password (RECOMMENDED)
# Generate with: ./schedule-api -hash "your_password"
ADMIN_PASSWORD_HASH=

# Option 2: Docker Secret / File Path (RECOMMENDED FOR PRODUCTION DOCKER)
# Points to a file containing the bcrypt hash
# ADMIN_PASSWORD_HASH_FILE=/app/.admin_hash

# Option 3: Plaintext Password (Automatic in-memory hashing fallback)
# ADMIN_PASSWORD=your_password

